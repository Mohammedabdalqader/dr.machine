# Edge Function secrets. Set them in the cloud project with:
#   npx supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first; it is git-ignored)
AI_PROVIDER=deepinfra
DEEPINFRA_API_KEY=
# Optional overrides (defaults in supabase/functions/_shared/ai/config.ts)
# AI_MODEL_REASONING=meta-llama/Llama-3.3-70B-Instruct-Turbo
# AI_MODEL_EXTRACTION=meta-llama/Llama-3.3-70B-Instruct-Turbo
# AI_MODEL_VISION=Qwen/Qwen2.5-VL-32B-Instruct
# AI_MODEL_EMBEDDING=BAAI/bge-m3
# AI_MODEL_SPEECH=openai/whisper-large-v3-turbo
# AI_EMBEDDING_DIM=1024
